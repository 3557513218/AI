# ============ 本地 AI Chat 配置 ============
# 使用 Ollama 运行本地模型，无需任何 API 密钥

# Ollama 服务地址（默认 http://localhost:11434）
OLLAMA_BASE_URL=http://localhost:11434

# 指定使用的模型（留空则自动选择最佳模型）
# 常用模型:
#   qwen2.5vl:7b      - 推荐，中文+英文+代码+图片分析全能 (7B, ~6GB)
#   qwen2.5:7b        - 纯文本版 (7B, ~4GB)
#   qwen2.5:14b       - 更强但需要更多内存 (14B, ~8GB)
#   deepseek-r1:7b    - DeepSeek 推理模型 (7B, ~4GB)
#   deepseek-r1:14b   - DeepSeek 更强版本
#   llama3.1:8b       - Meta 通用模型
#   gemma2:9b         - Google 模型
#   codegemma:2b      - 轻量代码模型
OLLAMA_MODEL=qwen2.5vl:7b

# 视觉模型（图片分析专用，留空则自动选择）
# 常用:
#   qwen2.5vl:7b      - 推荐，支持图片分析（也支持文字）
#   llava:7b          - 经典视觉模型
#   llava:13b         - 更强视觉模型
VISION_MODEL=qwen2.5vl:7b

# 服务器配置（可选）
HOST=0.0.0.0
PORT=8080
